# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored; never commit real keys.

# WeatherAPI.com key (used by /weather/grid and the precipitation tiles)
WEATHERAPI_API_KEY=

# Optional: override where the SQLite analytics database is stored
# (defaults to backend/data)
# AGOS_DATA_DIR=

# --- Scheduled data ingestion (optional, off by default) ---
# Refreshes the SQLite database from Open-Meteo for all 12 municipalities.
# Run the API with ONE worker when this is enabled.
AGOS_SCHEDULER_ENABLED=false
# Hours between refreshes (minimum 1)
AGOS_INGEST_INTERVAL_HOURS=6
# Days re-ingested on every refresh (1-30). Recent archive values arrive
# late, so re-ingesting fills gaps from earlier runs.
AGOS_INGEST_LOOKBACK_DAYS=7
# Also save the hourly forecast of every municipality on each refresh (default
# true). Saved forecasts are what lets AGOS measure forecast accuracy later.
# Use AGOS_INGEST_INTERVAL_HOURS=1 to save one forecast per hour.
AGOS_FORECAST_SNAPSHOT=true
